#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
//    ┌──────────┬────────────┬────────────┬──────┬──────┬───┬───────────┐                                            ┌───────────┬───┬──────┬────┬────────────┬────────────┬──────┐
//    │    =     │     1      │     2      │  3   │  4   │ 5 │   home    │                                            │    end    │ 6 │  7   │ 8  │     9      │     0      │  -   │
//    ├──────────┼────────────┼────────────┼──────┼──────┼───┼───────────┤                                            ├───────────┼───┼──────┼────┼────────────┼────────────┼──────┤
//    │   tab    │     Q      │     W      │  E   │  R   │ T │   tog 2   │                                            │   tog 1   │ Y │  U   │ I  │     O      │     P      │  \   │
//    ├──────────┼────────────┼────────────┼──────┼──────┼───┼───────────┤      ┌──────┬──────┐   ┌──────┬──────┐     ├───────────┼───┼──────┼────┼────────────┼────────────┼──────┤
//    │ lt 2 esc │     A      │     S      │  D   │  F   │ G │ lctl(spc) │      │ lctl │ lalt │   │ ralt │ rctl │     │ lctl(spc) │ H │  J   │ K  │     L      │   lt 2 ;   │  '   │
//    ├──────────┼────────────┼────────────┼──────┼──────┼───┼───────────┘      └──────┼──────┤   ├──────┼──────┘     └───────────┼───┼──────┼────┼────────────┼────────────┼──────┤
//    │   lsft   │ &hm lctl Z │ &hm lalt X │  C   │  V   │ B │                         │ caps │   │ del  │                        │ N │  M   │ ,  │ &hm ralt . │ &hm rctl / │ rsft │
//    ├──────────┼────────────┼────────────┼──────┼──────┼───┘           ┌──────┬──────┼──────┤   ├──────┼──────┬─────┐           └───┼──────┼────┼────────────┼────────────┼──────┤
//    │   mo 1   │     `      │            │ left │ rght │               │ bspc │ tab  │ lgui │   │ rgui │ ent  │ spc │               │ down │ up │     [      │     ]      │ mo 1 │
//    └──────────┴────────────┴────────────┴──────┴──────┘               └──────┴──────┴──────┘   └──────┴──────┴─────┘               └──────┴────┴────────────┴────────────┴──────┘
  &kp EQUAL   &kp N1        &kp N2       &kp N3     &kp N4      &kp N5   &kp HOME                                                                                 &kp END         &kp N6   &kp N7     &kp N8      &kp N9            &kp N0           &kp MINUS
  &kp TAB     &kp Q         &kp W        &kp E      &kp R       &kp T    &tog 2                                                                                   &tog 1          &kp Y    &kp U      &kp I       &kp O             &kp P            &kp BSLH
  &lt 2 ESC   &kp A         &kp S        &kp D      &kp F       &kp G    &kp LC(SPACE)              &kp LCTRL   &kp LALT       &kp RALT   &kp RCTRL               &kp LC(SPACE)   &kp H    &kp J      &kp K       &kp L             &lt 2 SEMI       &kp SQT
  &kp LSHFT   &hm LCTRL Z   &hm LALT X   &kp C      &kp V       &kp B                                           &kp CAPS       &kp DEL                                            &kp N    &kp M      &kp COMMA   &hm RALT PERIOD   &hm RCTRL FSLH   &kp RSHFT
  &mo 1       &kp GRAVE     &none        &kp LEFT   &kp RIGHT                            &kp BSPC   &kp TAB     &kp LGUI       &kp RGUI   &kp ENTER   &kp SPACE                            &kp DOWN   &kp UP      &kp LBKT          &kp RBKT         &mo 1
            >;
        };

        layer_keypad {
            display-name = "Keypad";
            bindings = <
//    ┌──────┬─────┬─────┬─────┬─────┬─────┬───────┐                                     ┌───────┬──────┬─────┬─────┬────┬─────┬───────┐
//    │      │ f1  │ f2  │ f3  │ f4  │ f5  │ pgup  │                                     │ pgdn  │  f6  │ f7  │ f8  │ f9 │ f10 │  f11  │
//    ├──────┼─────┼─────┼─────┼─────┼─────┼───────┤                                     ├───────┼──────┼─────┼─────┼────┼─────┼───────┤
//    │      │     │     │     │     │     │ tog 3 │                                     │ tog 1 │ kp_* │  7  │  8  │ 9  │  -  │  f12  │
//    ├──────┼─────┼─────┼─────┼─────┼─────┼───────┤     ┌─────┬─────┐   ┌─────┬─────┐   ├───────┼──────┼─────┼─────┼────┼─────┼───────┤
//    │ to 0 │     │     │     │     │     │       │     │     │     │   │     │     │   │       │  /   │  4  │  5  │ 6  │  +  │ lnlck │
//    ├──────┼─────┼─────┼─────┼─────┼─────┼───────┘     └─────┼─────┤   ├─────┼─────┘   └───────┼──────┼─────┼─────┼────┼─────┼───────┤
//    │      │     │     │     │     │     │                   │     │   │     │                 │      │  1  │  2  │ 3  │ ent │       │
//    ├──────┼─────┼─────┼─────┼─────┼─────┘       ┌─────┬─────┼─────┤   ├─────┼─────┬───┐       └──────┼─────┼─────┼────┼─────┼───────┤
//    │      │     │     │     │     │             │     │     │     │   │     │     │ 0 │              │     │     │ .  │     │       │
//    └──────┴─────┴─────┴─────┴─────┘             └─────┴─────┴─────┘   └─────┴─────┴───┘              └─────┴─────┴────┴─────┴───────┘
  &trans   &kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &kp PG_UP                                                             &kp PG_DN   &kp F6            &kp F7   &kp F8   &kp F9       &kp F10        &kp F11
  &trans   &trans   &trans   &trans   &trans   &trans   &tog 3                                                                &tog 1      &kp KP_MULTIPLY   &kp N7   &kp N8   &kp N9       &kp MINUS      &kp F12
  &to 0    &trans   &trans   &trans   &trans   &trans   &trans               &trans   &trans       &trans   &trans            &trans      &kp FSLH          &kp N4   &kp N5   &kp N6       &kp PLUS       &kp LNLCK
  &trans   &trans   &trans   &trans   &trans   &trans                                 &trans       &trans                                 &trans            &kp N1   &kp N2   &kp N3       &kp KP_ENTER   &trans
  &trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans       &trans   &trans   &kp N0                                 &trans   &trans   &kp PERIOD   &trans         &trans
            >;
        };

        layer_nav {
            display-name = "Nav";
            bindings = <
//    ┌──────┬─────┬─────┬─────┬─────┬─────┬───────┐                                       ┌───────┬──────┬──────┬─────┬──────┬─────┬─────┐
//    │      │     │     │     │     │     │       │                                       │       │      │      │     │      │     │     │
//    ├──────┼─────┼─────┼─────┼─────┼─────┼───────┤                                       ├───────┼──────┼──────┼─────┼──────┼─────┼─────┤
//    │      │     │     │     │     │     │ tog 2 │                                       │ tog 3 │      │      │     │      │     │     │
//    ├──────┼─────┼─────┼─────┼─────┼─────┼───────┤     ┌─────┬─────┐   ┌─────┬─────┐     ├───────┼──────┼──────┼─────┼──────┼─────┼─────┤
//    │ to 0 │     │     │     │     │     │       │     │     │     │   │     │     │     │       │ left │ down │ up  │ rght │     │     │
//    ├──────┼─────┼─────┼─────┼─────┼─────┼───────┘     └─────┼─────┤   ├─────┼─────┘     └───────┼──────┼──────┼─────┼──────┼─────┼─────┤
//    │      │     │     │     │     │     │                   │     │   │     │                   │      │      │     │      │     │     │
//    ├──────┼─────┼─────┼─────┼─────┼─────┘       ┌─────┬─────┼─────┤   ├─────┼─────┬─────┐       └──────┼──────┼─────┼──────┼─────┼─────┤
//    │      │     │     │     │     │             │     │     │     │   │     │     │     │              │      │     │      │     │     │
//    └──────┴─────┴─────┴─────┴─────┘             └─────┴─────┴─────┘   └─────┴─────┴─────┘              └──────┴─────┴──────┴─────┴─────┘
  &trans   &trans   &trans   &trans   &trans   &trans   &trans                                                             &trans   &trans     &trans     &trans   &trans      &trans   &trans
  &trans   &trans   &trans   &trans   &trans   &trans   &tog 2                                                             &tog 3   &trans     &trans     &trans   &trans      &trans   &trans
  &to 0    &trans   &trans   &trans   &trans   &trans   &trans            &trans   &trans       &trans   &trans            &trans   &kp LEFT   &kp DOWN   &kp UP   &kp RIGHT   &trans   &trans
  &trans   &trans   &trans   &trans   &trans   &trans                              &trans       &trans                              &trans     &trans     &trans   &trans      &trans   &trans
  &trans   &trans   &trans   &trans   &trans                     &trans   &trans   &trans       &trans   &trans   &trans                       &trans     &trans   &trans      &trans   &trans
            >;
        };

        layer_mod {
            display-name = "Mod";
            bindings = <
//    ┌──────┬──────────┬──────────┬──────────┬──────────┬──────────┬───────┐                                                   ┌───────┬─────┬─────┬─────┬─────┬─────┬─────┐
//    │ boot │ bt_sel 0 │ bt_sel 1 │ bt_sel 2 │ bt_sel 3 │ bt_sel 4 │       │                                                   │       │     │     │     │     │     │     │
//    ├──────┼──────────┼──────────┼──────────┼──────────┼──────────┼───────┤                                                   ├───────┼─────┼─────┼─────┼─────┼─────┼─────┤
//    │      │          │          │          │          │          │ tog 3 │                                                   │ tog 3 │     │     │     │     │     │     │
//    ├──────┼──────────┼──────────┼──────────┼──────────┼──────────┼───────┤     ┌─────┬────────┐   ┌─────────┬──────────┐     ├───────┼─────┼─────┼─────┼─────┼─────┼─────┤
//    │ to 0 │          │          │          │          │          │       │     │     │ bt_clr │   │ bl_ tog │ bl_ cycl │     │       │     │     │     │     │     │     │
//    ├──────┼──────────┼──────────┼──────────┼──────────┼──────────┼───────┘     └─────┼────────┤   ├─────────┼──────────┘     └───────┼─────┼─────┼─────┼─────┼─────┼─────┤
//    │      │          │          │          │          │          │                   │        │   │ bl_ on  │                        │     │     │     │     │     │     │
//    ├──────┼──────────┼──────────┼──────────┼──────────┼──────────┘       ┌─────┬─────┼────────┤   ├─────────┼──────────┬─────┐       └─────┼─────┼─────┼─────┼─────┼─────┤
//    │      │          │          │          │          │                  │     │     │        │   │ bl_ off │          │     │             │     │     │     │     │     │
//    └──────┴──────────┴──────────┴──────────┴──────────┘                  └─────┴─────┴────────┘   └─────────┴──────────┴─────┘             └─────┴─────┴─────┴─────┴─────┘
  &bootloader   &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &trans                                                                           &trans   &trans   &trans   &trans   &trans   &trans   &trans
  &trans        &trans         &trans         &trans         &trans         &trans         &tog 3                                                                           &tog 3   &trans   &trans   &trans   &trans   &trans   &trans
  &to 0         &trans         &trans         &trans         &trans         &trans         &trans            &trans   &bt BT_CLR       &bl BL_TOG   &bl BL_CYCLE            &trans   &trans   &trans   &trans   &trans   &trans   &trans
  &trans        &trans         &trans         &trans         &trans         &trans                                    &trans           &bl BL_ON                                     &trans   &trans   &trans   &trans   &trans   &trans
  &trans        &trans         &trans         &trans         &trans                                 &trans   &trans   &trans           &bl BL_OFF   &trans         &trans                     &trans   &trans   &trans   &trans   &trans
            >;
        };

        empty_layer {
            display-name = "";
            bindings = <
//    ┌─────┬─────┬─────┬─────┬─────┬─────┬─────┐                                       ┌─────┬─────┬─────┬─────┬─────┬─────┬─────┐
//    │     │     │     │     │     │     │     │                                       │     │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┼─────┤                                       ├─────┼─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │     │                                       │     │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┼─────┤     ┌─────┬─────┐   ┌─────┬─────┐     ├─────┼─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │     │     │     │     │   │     │     │     │     │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┼─────┘     └─────┼─────┤   ├─────┼─────┘     └─────┼─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │                 │     │   │     │                 │     │     │     │     │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┘     ┌─────┬─────┼─────┤   ├─────┼─────┬─────┐     └─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │           │     │     │     │   │     │     │     │           │     │     │     │     │     │
//    └─────┴─────┴─────┴─────┴─────┘           └─────┴─────┴─────┘   └─────┴─────┴─────┘           └─────┴─────┴─────┴─────┴─────┘
  &trans   &trans   &trans   &trans   &trans   &trans   &trans                                                             &trans   &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans   &trans   &trans                                                             &trans   &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans   &trans   &trans            &trans   &trans       &trans   &trans            &trans   &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans   &trans                              &trans       &trans                              &trans   &trans   &trans   &trans   &trans   &trans
  &trans   &trans   &trans   &trans   &trans                     &trans   &trans   &trans       &trans   &trans   &trans                     &trans   &trans   &trans   &trans   &trans
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
